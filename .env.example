# Copy to .env for local testing with `netlify dev`. Never commit .env.
# Option A: Gmail sender (no domain needed). Leave the Resend lines blank.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Option B: Resend (needs a domain you control). Leave the Gmail lines blank.
RESEND_API_KEY=
FROM_EMAIL=
SCHOOL_DOMAIN=gsumail.gram.edu
COPY_TO=
# Optional. The roster ships in netlify/lib/contacts.mjs. Set this only to override it
# without a code change, same shape: {"1":{"email":"...","phone":"+13185551234","groupme":"..."}}
AMBASSADOR_CONTACTS=
